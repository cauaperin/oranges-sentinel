# Copie para .env (não versionado) ou configure no painel do Render.

SPRING_PROFILES_ACTIVE=prod

# Supabase: Project Settings > Database > Connection string (Session pooler), no formato JDBC
DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<senha-do-banco>
DB_POOL_SIZE=5

# Chaves públicas do serviço auth (o banco só valida tokens) e o emissor esperado
AUTH_JWKS_URI=https://<servico-auth>.onrender.com/.well-known/jwks.json
JWT_ISSUER=orangesentinel-auth

# Chave compartilhada nas chamadas entre serviços (header X-Internal-Key): a mesma do auth e do motor.
# Gere com: openssl rand -base64 32
INTERNAL_KEY=<mesma-chave-do-auth>

# Motor antifraude: avalia cada Pix. Vazio desativa (Pix aprovado sem análise em tempo real).
MOTOR_URL=https://<servico-motor>.onrender.com
MOTOR_TIMEOUT=PT3S

# Origens permitidas para o frontend em desenvolvimento (separadas por vírgula)
CORS_ORIGINS=

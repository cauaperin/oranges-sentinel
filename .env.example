# Copie para .env (não versionado) ou configure no painel do Render.

SPRING_PROFILES_ACTIVE=prod

# Supabase: Project Settings > Database > Connection string (Session pooler), no formato JDBC
DATABASE_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<senha-do-banco>
DB_POOL_SIZE=5

# Segredo HS256 do JWT: no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=<gere-um-segredo-forte>
JWT_EXPIRACAO=PT8H

# Administrador criado na primeira inicialização
ADMIN_EMAIL=admin@orangesentinel.dev
ADMIN_PASSWORD=<senha-forte>

# Origens permitidas para o frontend em desenvolvimento (separadas por vírgula)
CORS_ORIGINS=

# Análise completa do grafo agendada (cron do Spring: seg min hora dia mês dia-semana)
ANTIFRAUDE_AGENDAMENTO=true
ANTIFRAUDE_CRON=0 */15 * * * *
